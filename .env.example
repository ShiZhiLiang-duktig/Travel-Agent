# ── 数据库（PostgreSQL + PgVector）──
# 默认与 docker-compose.yml 一致
DATABASE_URL=postgres://travel:travel@localhost:5432/travel

# ── Embedding 提供方 ──
# local（默认，本地哈希，零 Key 零依赖） | zhipu（智谱 embedding-3，需 ZHIPU_API_KEY）
EMBEDDING_PROVIDER=local

# ── 大模型 Key（按需填写；未填则该项在 UI 显示「未配置」，运行时自动回退 faux）──
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
QIANFAN_API_KEY=
STEPFUN_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── 服务端口 ──
PORT=8787

# ── 高德地图 Web 服务 Key（后端代理用，仅存服务端，不回传前端）──
# 申请地址：https://console.amap.com/  → 应用管理 → 创建「Web服务」类型 Key
# 未填时 /api/amap/* 返回 503，前端自动降级为「示意图」打点
AMAP_KEY=

# ── 高德地图 Web端(JS API) Key（前端加载真实地图瓦片用）──
# 注意：与上面的 AMAP_KEY 是不同平台类型的 Key，不能混用。
# 申请地址：https://console.amap.com/  → 应用管理 → 创建「Web端(JS API)」类型 Key
# 未填时地图区域自动降级为「示意图」打点。
# 修改后需重新构建前端：npm run build:web
VITE_AMAP_KEY=

# 与该 JS API Key 配对的安全密钥（高德控制台 → 安全密钥），缺少会报 INVALID_USER_SCODE
VITE_AMAP_SECURITY_CODE=

# ── 12306 余票查询（ModelScope Hosted MCP，Streamable HTTP）──
# 在 ModelScope MCP 广场选择 12306 服务并部署后，把专属 Remote URL 填到这里
# 属于专属连接地址，等同凭证，禁止提交仓库；留空则城际交通回退为估算
RAILWAY_MCP_URL=

# ── 航班班次/余票查询（可选，ModelScope Hosted MCP）──
# 12306 有统一公开的 Hosted MCP，所以高铁默认能查到实时余票；
# 航班没有统一公开接口，必须自己接一个数据源，否则卡片显示「暂未接入航班数据源」。
#
# 接法（任选其一，都是把地址填到 FLIGHT_MCP_URL）：
#   1) 魔搭 MCP 广场 → 搜「variflight」飞常准 / 「FlightTicketMCP」，部署后在服务详情复制专属地址
#   2) 飞常准开放平台 https://www.variflight.com/ 的 API，自行包一层 MCP 或改造 flight.ts
#   3) 携程 / 去哪儿 / Amadeus 等商业机票 API（需商务资质与 Key）
#
# 地址两种写法都支持（注意必须带专属 ID，缺 ID 会 404 record not found）：
#   Streamable HTTP：https://mcp.api-inference.modelscope.net/<专属ID>/mcp
#   旧版 SSE：       https://mcp.api-inference.modelscope.net/sse/<专属ID>
#
# FLIGHT_MCP_TOOL 留空时自动挑选工具，优先级：
#   1) 名字含 price / fare / cabin / ticket 的工具（如 variflight 的 getFlightPriceByCities，
#      返回舱位余票数 + 票面价 + 机建燃油，能直接回答「有没有票、多少钱」）
#   2) 其余航班查询工具（如 searchFlightsByDepArr，只有时刻表与准点率，余票标注「以航司为准」）
# 参数名（dep_city/arr_city、depcity/arrcity、dep/arr 等）按 inputSchema 自动适配，
# 城市名自动转 IATA 三字码（北京 → BJS 城市码 / PEK 机场码）。
# 配好后可访问 GET /api/flight/health 自检（返回能否连上、有哪些工具、选了哪个），再重启服务。
FLIGHT_MCP_URL=
FLIGHT_MCP_TOOL=
